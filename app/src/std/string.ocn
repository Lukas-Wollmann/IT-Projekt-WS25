import math

struct str {
    data: []char
}

func str_print(s: str) {
    i: i32 = 0;

    while (i < len(s.data)) {
        print_char(s.data[i]);

        i += 1;
    }
}

func str_len(s: str) -> i32 {
    return len(s.data);
} 

func str_concat(a: str, b: str) -> str {
    size: i32 = str_len(a) + str_len(b);
    data: []char = array[size] char;

    i: i32 = 0;
    j: i32 = 0;
    while (i < str_len(a)) {
        data[i] = a.data[i];
        i += 1;
    }

    while (j < str_len(b)) {
        data[i + j] = a.data[j];
        j += 1;
    }

    return str { data };
}